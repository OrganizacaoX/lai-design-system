{
  "name": "@organizacaox/lai-design-system",
  "version": "0.2.0",
  "description": "Componentes React e registry shadcn do design system LAI.",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./lib/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "styles.css.d.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrganizacaoX/lai-design-system.git"
  },
  "homepage": "https://github.com/OrganizacaoX/lai-design-system#readme",
  "bugs": {
    "url": "https://github.com/OrganizacaoX/lai-design-system/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "registry:build": "node scripts/build-registry.mjs && shadcn build",
    "site:build": "npm run docs:build && npm run registry:build && vite build",
    "package:build": "vite build --config vite.lib.config.ts",
    "package:check": "tsc --project tsconfig.lib.json --noEmit",
    "build": "npm run site:build && npm run package:build",
    "preview": "vite preview",
    "start": "node server.mjs",
    "prepublishOnly": "npm run package:check && npm run package:build",
    "docs:build": "node scripts/build-docs.mjs",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:compositions": "playwright test --config playwright.compositions.config.ts",
    "test:consumers": "node scripts/check-consumers.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.41.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@microsoft/api-extractor": "^7.59.0",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "postcss": "^8.5.28",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  }
}
