{
  "name": "@organizacaox/lai-design-system",
  "version": "0.8.0",
  "description": "Componentes React e registry shadcn do design system LAI.",
  "homepage": "https://github.com/OrganizacaoX/lai-design-system#readme",
  "bugs": {
    "url": "https://github.com/OrganizacaoX/lai-design-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrganizacaoX/lai-design-system.git"
  },
  "files": [
    "lib",
    "skills",
    "styles.css.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./lib/styles.css"
    },
    "./package.json": "./package.json",
    "./app": {
      "types": "./lib/app/index.d.ts",
      "import": "./lib/app.js"
    },
    "./fetch": {
      "types": "./lib/entries/fetch.d.ts",
      "import": "./lib/fetch.js"
    },
    "./query": {
      "types": "./lib/entries/query.d.ts",
      "import": "./lib/query.js"
    },
    "./router": {
      "types": "./lib/entries/router.d.ts",
      "import": "./lib/router.js"
    },
    "./store": {
      "types": "./lib/entries/store.d.ts",
      "import": "./lib/store.js"
    },
    "./router/vite": {
      "types": "./lib/entries/router-vite.d.ts",
      "import": "./lib/router-vite.js"
    },
    "./i18n": {
      "types": "./lib/entries/i18n.d.ts",
      "import": "./lib/i18n.js"
    },
    "./table": {
      "types": "./lib/entries/table.d.ts",
      "import": "./lib/table.js"
    },
    "./form": {
      "types": "./lib/entries/form.d.ts",
      "import": "./lib/form.js"
    },
    "./schema": {
      "types": "./lib/entries/schema.d.ts",
      "import": "./lib/schema.js"
    },
    "./dnd": {
      "types": "./lib/entries/dnd.d.ts",
      "import": "./lib/dnd.js"
    },
    "./virtual": {
      "types": "./lib/entries/virtual.d.ts",
      "import": "./lib/virtual.js"
    },
    "./auth": {
      "types": "./lib/entries/auth.d.ts",
      "import": "./lib/auth.js"
    },
    "./auth/plugins": {
      "types": "./lib/entries/auth-plugins.d.ts",
      "import": "./lib/auth-plugins.js"
    },
    "./analytics": {
      "types": "./lib/entries/analytics.d.ts",
      "import": "./lib/analytics.js"
    },
    "./tour": {
      "types": "./lib/entries/tour.d.ts",
      "import": "./lib/tour.js"
    },
    "./testing": {
      "types": "./lib/entries/testing.d.ts",
      "import": "./lib/testing.js"
    },
    "./motion": {
      "types": "./lib/entries/motion.d.ts",
      "import": "./lib/motion.js"
    },
    "./date": {
      "types": "./lib/entries/date.d.ts",
      "import": "./lib/date.js"
    },
    "./date/locale": {
      "types": "./lib/entries/date-locale.d.ts",
      "import": "./lib/date-locale.js"
    },
    "./icons": {
      "types": "./lib/entries/icons.d.ts",
      "import": "./lib/icons.js"
    },
    "./ai": {
      "types": "./lib/entries/ai.d.ts",
      "import": "./lib/ai.js"
    },
    "./ai/client": {
      "types": "./lib/entries/ai-client.d.ts",
      "import": "./lib/ai-client.js"
    },
    "./ai/testing": {
      "types": "./lib/entries/ai-testing.d.ts",
      "import": "./lib/ai-testing.js"
    },
    "./tour/styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./lib/tour.css"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "registry:build": "node scripts/build-registry.mjs && shadcn build",
    "site:build": "npm run docs:build && npm run registry:build && vite build",
    "package:build": "vite build --config vite.lib.config.ts",
    "package:check": "tsc --project tsconfig.lib.json --noEmit",
    "build": "npm run site:build && npm run package:build",
    "preview": "vite preview",
    "start": "node server.mjs",
    "prepublishOnly": "npm run package:check && npm run package:build",
    "docs:build": "node scripts/build-docs.mjs",
    "check": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:e2e": "playwright test",
    "test:compositions": "playwright test --config playwright.compositions.config.ts",
    "test:consumers": "node scripts/check-consumers.mjs",
    "test:reliability": "node scripts/test-reliability.mjs",
    "test:reliability-unit": "node --test scripts/reliability/*.test.mjs",
    "test:app": "node scripts/check-app-consumer.mjs"
  },
  "dependencies": {
